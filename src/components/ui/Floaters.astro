---
// Floating BIM-flavoured bits (file formats, a model cube, a dimension line, a mini floor plan).
// Positions are % of the host section; z = parallax depth. Decorative only.
interface Item {
  t: 'chip' | 'cube' | 'dim' | 'plan' | 'pts';
  x: number;
  y: number;
  z?: number;
  d?: number;
  l?: string;
  i?: string;
  m?: boolean; // keep on mobile
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="dt-fl" aria-hidden="true" data-fl>
  {
    items.map((o, n) => (
      <span
        class={`dt-fl__i dt-fl__i--${o.t}${o.m ? ' is-m' : ''}`}
        style={`left:${o.x}%;top:${o.y}%;--z:${o.z ?? 1};--d:${o.d ?? n * -1.7}s`}
      >
        <span class="dt-fl__in">
          {o.t === 'chip' && (
            <>
              <svg
                viewBox="0 0 20 20"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {o.i === 'file' && <path d="M5 2.5h6.5L15 6v11.5H5zM11.5 2.5V6H15M8 11h4M8 14h4" />}
                {o.i === 'layers' && <path d="m10 3 7 3.5-7 3.5-7-3.5zm-7 7 7 3.5 7-3.5M3 13.5 10 17l7-3.5" />}
                {o.i === 'check' && <path d="m4 10.5 4 4 8-9" />}
                {o.i === 'db' && (
                  <path d="M4 5.5C4 4.4 6.7 3.5 10 3.5s6 .9 6 2-2.7 2-6 2-6-.9-6-2zm0 0v9c0 1.1 2.7 2 6 2s6-.9 6-2v-9M4 10c0 1.1 2.7 2 6 2s6-.9 6-2" />
                )}
                {o.i === 'flag' && <path d="M5 17.5v-15M5 3.5h9l-2 3.5 2 3.5H5" />}
                {o.i === 'cloud' && <path d="M6 15.5a3.5 3.5 0 0 1-.4-7 4.5 4.5 0 0 1 8.7-.8A3.7 3.7 0 0 1 14 15.5z" />}
              </svg>
              <b>{o.l}</b>
            </>
          )}
          {o.t === 'cube' && (
            <svg
              viewBox="0 0 64 64"
              width="56"
              height="56"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            >
              <path d="M32 6 56 19v26L32 58 8 45V19z" />
              <path d="M8 19l24 13 24-13M32 32v26" />
              <path d="m32 6 12 6.5M20 12.5 32 19" opacity=".5" />
            </svg>
          )}
          {o.t === 'dim' && (
            <>
              <svg
                viewBox="0 0 120 22"
                width="120"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
              >
                <path d="M2 4v14M118 4v14M2 11h38M80 11h38M6 7.5 2 11l4 3.5M114 7.5l4 3.5-4 3.5" />
              </svg>
              <b>{o.l}</b>
            </>
          )}
          {o.t === 'plan' && (
            <svg
              viewBox="0 0 90 64"
              width="96"
              height="68"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            >
              <path d="M4 4h82v56H4zM4 26h30M52 4v22h34M34 26v34M52 26v14M34 44h28" />
              <path d="M34 26a6 6 0 0 0 6-6" opacity=".6" />
            </svg>
          )}
          {o.t === 'pts' && (
            <svg viewBox="0 0 70 50" width="76" height="54" fill="currentColor">
              {Array.from({ length: 26 }, (_, k) => (
                <circle
                  cx={6 + ((k * 23) % 60)}
                  cy={5 + ((k * 17) % 40)}
                  r={1 + (k % 3) * 0.5}
                  opacity={0.35 + (k % 4) * 0.15}
                />
              ))}
            </svg>
          )}
        </span>
      </span>
    ))
  }
</div>

<style is:global>
  .dt-fl {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: clip;
    --px: 0;
    --py: 0;
  }
  .dt-fl__i {
    position: absolute;
    translate: calc(var(--px) * var(--z) * -22px) calc(var(--py) * var(--z) * -16px);
    transition: translate 0.9s var(--dt-ease);
  }
  .dt-fl__in {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(150, 224, 252, 0.8);
    animation: dt-fl 9s ease-in-out infinite alternate;
    animation-delay: var(--d);
    will-change: transform;
  }
  @keyframes dt-fl {
    0% {
      transform: translate3d(0, 0, 0) rotate(-1.5deg);
    }
    100% {
      transform: translate3d(0, -16px, 0) rotate(1.5deg);
    }
  }
  .dt-fl__i b {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
  }
  .dt-fl__i--chip .dt-fl__in {
    padding: 9px 13px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(150, 224, 252, 0.28);
    backdrop-filter: blur(6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  }
  .dt-fl__i--dim .dt-fl__in {
    flex-direction: column;
    gap: 2px;
    align-items: center;
  }
  .dt-fl__i--cube .dt-fl__in {
    animation-name: dt-fl-spin;
    animation-duration: 14s;
  }
  @keyframes dt-fl-spin {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    100% {
      transform: translate3d(0, -14px, 0) rotate(8deg);
    }
  }
  [data-live].is-paused .dt-fl__in {
    animation-play-state: paused;
  }
  @media (max-width: 900px) {
    .dt-fl__i:not(.is-m) {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-fl]').forEach((fl) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const host = (fl.closest('section') as HTMLElement) || fl;
    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      fl.style.setProperty('--px', String(((e.clientX - r.left) / r.width - 0.5) * 2));
      fl.style.setProperty('--py', String(((e.clientY - r.top) / r.height - 0.5) * 2));
    });
  });
</script>

---
interface Props {
  class?: string;
  density?: number;
}
const { class: cls = '', density = 1 } = Astro.props;
---

<div class={`dt-net ${cls}`} aria-hidden="true">
  <canvas data-net data-density={density}></canvas>
</div>

<style is:global>
  .dt-net {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .dt-net canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-net]').forEach((cv) => {
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const density = Number(cv.dataset.density || 1);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    type P = { x: number; y: number; vx: number; vy: number; r: number };
    let pts: P[] = [];
    let w = 0,
      h = 0,
      dpr = 1,
      raf = 0,
      run = false,
      mx = -9999,
      my = -9999;
    const host = cv.parentElement as HTMLElement;
    const size = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = host.clientWidth;
      h = host.clientHeight;
      cv.width = w * dpr;
      cv.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(110, ((w * h) / 15000) * density));
      pts = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
        r: 1.2 + Math.random() * 1.6,
      }));
    };
    const draw = (step: boolean) => {
      ctx.clearRect(0, 0, w, h);
      const link = Math.max(110, Math.min(170, w / 9));
      for (const p of pts) {
        if (step) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < -20) p.x = w + 20;
          if (p.x > w + 20) p.x = -20;
          if (p.y < -20) p.y = h + 20;
          if (p.y > h + 20) p.y = -20;
        }
      }
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < link) {
            const near = Math.hypot((a.x + b.x) / 2 - mx, (a.y + b.y) / 2 - my) < 160;
            ctx.strokeStyle = `rgba(0,172,236,${(1 - d / link) * (near ? 0.85 : 0.45)})`;
            ctx.lineWidth = near ? 1.3 : 0.8;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      for (const p of pts) {
        ctx.fillStyle = 'rgba(140,222,250,.75)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, 6.283);
        ctx.fill();
      }
    };
    const loop = () => {
      if (!run) return;
      draw(true);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (run || reduce) return;
      run = true;
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      run = false;
      cancelAnimationFrame(raf);
    };
    size();
    draw(false);
    addEventListener('resize', () => {
      size();
      draw(false);
    });
    const sec = host.closest('section') || host;
    sec.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      mx = (e as PointerEvent).clientX - r.left;
      my = (e as PointerEvent).clientY - r.top;
    });
    sec.addEventListener('pointerleave', () => {
      mx = my = -9999;
    });
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0 }).observe(host);
  });
</script>

---
import Icon from '../ui/Icon.astro';
import { pick, URLS, type Lang } from '../../i18n';
import home from '../../i18n/home.json';
interface Props {
  lang: Lang;
}
const t = pick(home, Astro.props.lang);
const href = (k: string) => URLS[k as keyof typeof URLS];
const ext = (k: string) => (k === 'konzultace' || k === 'pasportizace' ? { target: '_blank', rel: 'noopener' } : {});
---

<section class="dt-section dt-sol" id="reseni">
  <div class="dt-wrap">
    <p class="dt-kicker" data-reveal>{t.sol_kicker}</p>
    <h2 class="dt-h2 dt-lines"><span class="dt-line"><span>{t.sol_h2}</span></span></h2>

    <div class="dt-tabs" data-tabs>
      <div class="dt-tabs__list" role="tablist" aria-label={t.sol_label} data-reveal style="--i:1">
        {
          t.sol.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${s.id}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="dt-tabs__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {s.l}
            </button>
          ))
        }
        <span class="dt-tabs__bar" aria-hidden="true"></span>
      </div>
      <div class="dt-tabs__panels" data-reveal style="--i:2">
        {
          t.sol.map((s, i) => (
            <div
              class="dt-panel"
              role="tabpanel"
              id={`panel-${s.id}`}
              aria-labelledby={`tab-${s.id}`}
              hidden={i !== 0}
              tabindex="0"
            >
              <h3>{s.l}</h3>
              <div class="dt-panel__body">
                {s.ps.map((p) => (
                  <p>{p}</p>
                ))}
                {s.list && (
                  <ul class="dt-panel__list">
                    {s.list.map((li) => (
                      <li>
                        <Icon name="check" size={18} />
                        <span>{li}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {s.links && (
                  <ul class="dt-panel__links">
                    {s.links.map((l) => (
                      <li>
                        <a class="dt-link" href={href(l.k)}>
                          {l.t} <Icon name="arrow" size={16} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {s.after && <p>{s.after}</p>}
              </div>
              <div class="dt-panel__ctas">
                {s.ctas.map((c) => (
                  <a class={`dt-btn ${c.ghost ? 'dt-btn--outline-dark' : ''}`} href={href(c.k)} {...ext(c.k)}>
                    {c.t}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const bar = root.querySelector<HTMLElement>('.dt-tabs__bar');
    const place = () => {
      const a = tabs.find((x) => x.getAttribute('aria-selected') === 'true');
      if (!a || !bar) return;
      bar.style.setProperty('--x', a.offsetLeft + 'px');
      bar.style.setProperty('--y', a.offsetTop + 'px');
      bar.style.setProperty('--w', a.offsetWidth + 'px');
      bar.style.setProperty('--h', a.offsetHeight + 'px');
    };
    const select = (i: number, focus = false) => {
      tabs.forEach((tb, k) => {
        tb.setAttribute('aria-selected', String(k === i));
        tb.tabIndex = k === i ? 0 : -1;
        panels[k].hidden = k !== i;
      });
      if (focus) tabs[i].focus();
      place();
    };
    tabs.forEach((tb, i) => {
      tb.addEventListener('click', () => select(i));
      tb.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const map: Record<string, number> = {
          ArrowRight: (i + 1) % n,
          ArrowDown: (i + 1) % n,
          ArrowLeft: (i + n - 1) % n,
          ArrowUp: (i + n - 1) % n,
          Home: 0,
          End: n - 1,
        };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key], true);
        }
      });
    });
    place();
    addEventListener('resize', place);
    document.fonts?.ready.then(place);
  });
</script>

<style is:global>
  .dt-sol {
    background: #fff;
  }
  .dt-tabs {
    margin-top: clamp(36px, 4vw, 60px);
    display: grid;
    grid-template-columns: minmax(220px, 0.36fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: start;
  }
  .dt-tabs__list {
    position: relative;
    display: grid;
    gap: 8px;
  }
  .dt-tabs__list button {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    border: 0;
    border-radius: var(--dt-r);
    background: transparent;
    font-family: var(--dt-head);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--dt-navy);
    text-align: left;
    cursor: pointer;
    transition: color var(--dt-med) var(--dt-ease);
  }
  .dt-tabs__list button[aria-selected='true'] {
    color: #fff;
  }
  .dt-tabs__list button:not([aria-selected='true']):hover {
    background: var(--dt-mist);
  }
  .dt-tabs__n {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    opacity: 0.55;
  }
  .dt-tabs__bar {
    position: absolute;
    z-index: 0;
    left: 0;
    top: 0;
    width: var(--w, 0);
    height: var(--h, 0);
    translate: var(--x, 0) var(--y, 0);
    border-radius: var(--dt-r);
    background: linear-gradient(110deg, var(--dt-navy) 0%, var(--dt-navy-2) 100%);
    box-shadow: var(--dt-shadow);
    transition:
      translate var(--dt-med) var(--dt-ease),
      width var(--dt-med) var(--dt-ease),
      height var(--dt-med) var(--dt-ease);
  }
  .dt-tabs__panels {
    min-height: 100%;
    padding: clamp(28px, 4vw, 60px);
    background: var(--dt-sky-2);
    border-radius: var(--dt-r-lg);
    border: 1px solid var(--dt-line);
  }
  .dt-panel[hidden] {
    display: none;
  }
  .dt-panel {
    display: grid;
    gap: 22px;
    animation: dt-panel-in 0.6s var(--dt-ease) both;
  }
  @keyframes dt-panel-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }
  .dt-panel h3 {
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 3rem);
    color: var(--dt-navy);
  }
  .dt-panel__body {
    display: grid;
    gap: 16px;
    max-width: 44em;
    color: var(--dt-grey);
  }
  .dt-panel__list,
  .dt-panel__links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .dt-panel__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--dt-ink);
    font-weight: 600;
  }
  .dt-panel__list svg {
    flex: none;
    margin-top: 4px;
    padding: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--dt-blue);
    color: #fff;
  }
  .dt-panel__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  @media (max-width: 900px) {
    .dt-tabs {
      grid-template-columns: 1fr;
    }
    .dt-tabs__list {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .dt-tabs__list button {
      flex: none;
      padding: 14px 18px;
      font-size: 1.05rem;
    }
  }
</style>

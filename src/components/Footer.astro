---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { pick, FIRM, URLS, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(chrome, lang);
---

<footer class="dt-footer dt-dark">
  <div class="dt-wrap dt-footer__in">
    <div class="dt-footer__brand">
      <a href="/" aria-label={t.home}><Logo /></a>
      <address>
        <b>{FIRM.name}</b><br />
        {FIRM.street}, {FIRM.zip}
        {FIRM.city}<br />
        <a href={FIRM.officeHref}>{FIRM.office}</a>
      </address>
    </div>
    <div class="dt-footer__right">
      <p class="dt-footer__h">Sledujte nás</p>
      <div class="dt-footer__social" role="list" aria-label={t.social_label}>
        <a role="listitem" href={URLS.facebook} target="_blank" rel="noopener" aria-label={t.facebook}
          ><Icon name="facebook" size={22} /></a
        >
        <a role="listitem" href={URLS.linkedin} target="_blank" rel="noopener" aria-label={t.linkedin}
          ><Icon name="linkedin" size={22} /></a
        >
        <a role="listitem" href={URLS.youtube} target="_blank" rel="noopener" aria-label={t.youtube}
          ><Icon name="youtube" size={22} /></a
        >
        <a role="listitem" href={URLS.newsletter} target="_blank" rel="noopener" aria-label={t.newsletter}
          ><Icon name="mail" size={22} /></a
        >
        <a class="dt-footer__top" href="#top" aria-label={t.to_top}><Icon name="up" size={22} /></a>
      </div>
    </div>
  </div>
  <div class="dt-wrap dt-footer__legal">
    <p>{t.copyright}</p>
  </div>
</footer>

<style is:global>
  .dt-footer {
    position: relative;
    background: var(--dt-navy-d);
    padding-block: 72px 28px;
    border-radius: var(--dt-r-lg) var(--dt-r-lg) 0 0;
    margin-top: calc(var(--dt-r-lg) * -1);
  }
  .dt-footer__in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
  }
  .dt-footer__brand {
    display: grid;
    gap: 28px;
    color: #fff;
  }
  .dt-footer address {
    font-style: normal;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.7;
  }
  .dt-footer address b {
    color: #fff;
  }
  .dt-footer a {
    text-decoration: none;
  }
  .dt-footer address a:hover {
    color: var(--dt-blue-l);
  }
  .dt-footer__h {
    margin-bottom: 16px;
    font-family: var(--dt-head);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .dt-footer__social {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
  }
  .dt-footer__social a {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.28);
    color: #fff;
    transition:
      background-color var(--dt-fast) var(--dt-ease),
      color var(--dt-fast) var(--dt-ease),
      transform var(--dt-med) var(--dt-ease);
  }
  .dt-footer__social a:hover {
    background: #fff;
    color: var(--dt-navy);
    transform: translateY(-4px);
  }
  .dt-footer__legal {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
